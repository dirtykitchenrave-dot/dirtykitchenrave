# Public URL of the site (canonical URLs, sitemap, RSS, Open Graph)
NEXT_PUBLIC_SITE_URL=https://dirtykitchenrave.com

# Contact email shown on /about and /links (defaults to dirtykitchenrave@gmail.com)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Database (Supabase) ---------------------------------------------------
# Empty -> the site reads data/catalog.seed.json.
# Set both -> the site reads the tables from supabase/migrations/001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used by `npm run import:beatport -- --supabase` and the daily cron.
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/beatport-sync. On Vercel, Vercel Cron sends it automatically.
CRON_SECRET=

# LOCAL ONLY (corporate proxy with SSL inspection, e.g. Acttax). Lets /api/audio-proxy skip TLS verification
# when `next start` runs on this machine. `next dev` does it without this flag. Ignored on Vercel. Never set in production.
ALLOW_INSECURE_UPSTREAM_TLS=

# --- Streaming links (npm run match:streaming) ---------------------------
# Spotify: developer.spotify.com -> app -> client credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# TIDAL: developer.tidal.com -> app -> client credentials
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
