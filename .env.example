# Public URL of the site (canonical URLs, sitemap, RSS, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.dirtykitchenrave.com

# GA4 measurement id (public). Empty -> no tag. Consent Mode v2 stays denied until the banner accepts.
# Must also be set in Vercel or production ships without analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Contact email shown on /about and /links (defaults to dirtykitchenrave@gmail.com)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Admin (no database) ---------------------------------------------------
# Label account for /administrator. The password is never committed.
ADMIN_EMAIL=dirtykitchenrave@gmail.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Lets the admin commit data/catalog.seed.json and data/bookings.json.
# Fine-grained token, contents: write, on dirtykitchenrave-dot/dirtykitchenrave.
# Without it, saves only work on this machine (they write the files on disk).
GITHUB_TOKEN=
GITHUB_REPO=dirtykitchenrave-dot/dirtykitchenrave

# Optional. Old importer path. The public site does not read Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/beatport-sync. On Vercel, Vercel Cron sends it automatically.
CRON_SECRET=

# LOCAL ONLY (corporate proxy with SSL inspection, e.g. Acttax). Lets /api/audio-proxy skip TLS verification
# when `next start` runs on this machine. `next dev` does it without this flag. Ignored on Vercel. Never set in production.
ALLOW_INSECURE_UPSTREAM_TLS=

# --- Streaming links (npm run match:streaming) ---------------------------
# Spotify: developer.spotify.com -> app -> client credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# TIDAL: developer.tidal.com -> app -> client credentials
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
